# ==========================================
# POTHOLE REPORTING PLATFORM - ENVIRONMENT TEMPLATE
# Copy to .env and configure values before starting
# ==========================================

# SERVER & APPLICATION CONFIG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# DATABASE
# Default: local SQLite for zero-config local dev. Production: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./pothole_platform.db

# SECURITY & AUTHENTICATION
# Generate a secure 32+ character key, e.g., `openssl rand -hex 32`
AUTH_SECRET=your_jwt_secret_key_change_in_production_min32chars
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_INITIAL_EMAIL=admin@civicworks.org
ADMIN_INITIAL_PASSWORD=admin_secure_change_me_123

# MODEL & INFERENCE CONFIGURATION
MODEL_VERSION=v1
MODEL_WEIGHTS_PATH=./ml/models/pothole_classifier_v1.pt
MODEL_METADATA_PATH=./ml/models/pothole_classifier_v1_metadata.json
POTHOLE_CONFIDENCE_THRESHOLD=0.75
DEVICE=cpu

# FILE STORAGE CONFIGURATION
# Local storage mode: 'local' | Cloud mode: 's3'
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads/potholes
MAX_UPLOAD_SIZE_MB=10

# EMAIL NOTIFICATION (Admin alert when pothole is confirmed)
# Provider options: 'console' (prints to logs for testing) | 'smtp' | 'resend'
EMAIL_PROVIDER=console
EMAIL_FROM=alerts@civicworks.org
ADMIN_ALERT_EMAIL=admin@civicworks.org
# If using SMTP:
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
# If using Resend:
RESEND_API_KEY=re_your_resend_api_key

# MAPS & GEOCODING (Optional)
# OpenStreetMap / Leaflet requires NO key for client-side tiles.
# Optional reverse geocoding (Nominatim by default has no key, or Mapbox if desired):
REVERSE_GEOCODING_ENABLED=true
